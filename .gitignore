# Dependencies
node_modules/
.pnpm-store/

# Python sidecar virtualenv and caches — 892 MB, rebuilt from requirements.txt
services/docai-engine/.venv*/
**/__pycache__/
*.pyc

# Uploaded originals. These are CAPTURED DOCUMENTS — someone's receipts and
# invoices, and under the ATO rules the legal record. They belong in object
# storage with tenant-scoped access, never in a git history that cannot be
# unpublished.
apps/server/.storage/

# Build output
dist/
build/
# Next.js build output, including the alternate directories used so that two
# concurrent `next build` runs in one checkout do not corrupt each other's
# chunks (which presents as MODULE_NOT_FOUND on files that plainly exist).
# Globbed rather than listed: every new variant was otherwise one forgotten
# line away from being committed.
.next*/
# Auto-generated by Next on every build, and it REWRITES ITSELF to reference
# whichever dist directory was last used — so with the alternate build dirs
# above it churns constantly and gets committed pointing at someone's
# throwaway folder. Next's own template gitignores it for this reason.
next-env.d.ts
.expo/
.expo-web/
*.tsbuildinfo

# Local environment. No secret has ever lived in this repo and none should
# start now: the provider key is read from OLLAMA_ENV_FILE outside the tree.
.env
.env.*
# ...but every *.example file is documentation, not a secret. Written as a
# glob because `!.env.example` alone left `deploy/.env.local.example` ignored,
# which is how a template nobody can see gets "committed".
!.env*.example

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Expo web export — build output of `pnpm --filter @snap/mobile export:web`.
# Used to capture the marketing site's app screenshots (docs/WEB.md 4.6).
.expo-export/

# Agent / assistant scratch. These are one developer's local tooling — agent
# definitions, session settings, design explorations rendered by a tool — and
# they are not the project. They drift, they are large, and a reader looking
# for how Snap Apps works should never find them first. Kept locally, ignored
# here; the decisions they produced live in docs/ instead, which is the part
# worth reviewing.
.claude/
.design-directions/
CLAUDE.md
AGENTS.md
