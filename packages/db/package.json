{
  "name": "@snap/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Snap Apps database layer: hand-authored SQL migrations (source of truth) plus Drizzle declarations for typed queries. SERVER ONLY — never a dependency of the mobile app.",
  "license": "UNLICENSED",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "types": "./src/index.ts",
  "sideEffects": false,
  "files": [
    "src",
    "migrations",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:up": "node scripts/db.mjs up",
    "db:down": "node scripts/db.mjs down",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:reset": "node scripts/db.mjs reset"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "@types/pg": "^8.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "@snap/tax-rules": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  }
}
