# Throwaway values for LOCAL verification only (deploy/docker-compose.local.yml).
# Every secret below is generated fresh for this purpose — none of them are
# real, none of them are used anywhere else, and this file (once copied to
# deploy/.env.local) must never be committed.
#
#   cp deploy/.env.local.example deploy/.env.local
#   docker compose -f deploy/docker-compose.yml -f deploy/docker-compose.local.yml \
#     --env-file deploy/.env.local up -d --build

POSTGRES_SUPERUSER_PASSWORD=local-verify-superuser-throwaway
APP_DB_PASSWORD=local-verify-app-throwaway
SNAP_PG_CONTAINER=snap-postgres-verify

TOKEN_SECRET=local-verify-token-secret-not-real-000000000000
ADMIN_KMS_MASTER_KEY=676c9cda40a590bc34b1bbf8c92540955912efcbbe08d5bd943adbe34211687
# ^ throwaway 64-hex value (openssl rand -hex 32), regenerate for a real deploy

PUBLIC_URL=http://localhost:8092
WEB_PUBLIC_URL=http://localhost:8093
CORS_ORIGINS=http://localhost:8093

# Placeholder, NOT a real OAuth client. main.ts's assertProductionHasAWayIn()
# refuses to boot in production with no usable sign-in method at all (neither
# Google nor a real mailer); this satisfies that boot gate for verification
# purposes only. Sign-in itself is NOT exercised by this local check — see
# docs/DEPLOY.md §3 for wiring a real Google OAuth client before going live.
GOOGLE_CLIENT_ID=local-verify-placeholder-not-a-real-client-id
GOOGLE_CLIENT_SECRET=

STORAGE_HOST_DIR=/tmp/snap-apps-verify/storage

EXTRACTION_PROVIDER=ollama
EXTRACTION_MODEL=gemma4:31b
# Left unset for local verification: the worker idling without a key is the
# expected, provable state (it only reads the key on its first extraction
# attempt), and no real key belongs in a repo-adjacent file. Point this at a
# real OLLAMA_ENV_FILE_HOST to exercise actual extraction.
OLLAMA_ENV_FILE_HOST=

NODE_ENV=production

# Plain HTTP, non-standard ports — see docker-compose.local.yml. No ACME
# lookup happens for a bare http:// address, so CADDY_ACME_EMAIL is unused
# here but still required by the Caddyfile's global block.
API_ADDRESS=http://localhost:8092
WEB_ADDRESS=http://localhost:8093
CADDY_ACME_EMAIL=verify@example.invalid

LOCAL_PG_PORT=55599
LOCAL_API_PORT=4001
LOCAL_WEB_PORT=3001
LOCAL_CADDY_API_PORT=8092
LOCAL_CADDY_WEB_PORT=8093

IMAGE_TAG=verify
