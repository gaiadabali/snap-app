{
  "expo": {
    "name": "SnapApp",
    "slug": "snap-apps",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": [
      "snapapps",
      "au.com.snapapps.app"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "au.com.snapapps.app",
      "infoPlist": {
        "NSCameraUsageDescription": "SnapApp uses the camera to capture receipts and tax invoices.",
        "NSLocationWhenInUseUsageDescription": "SnapApp measures the distance of a work trip while you are recording it, so your logbook does not depend on remembering an odometer reading. Location is used only while the trip screen is open."
      },
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "au.com.snapapps.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EA542D"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-iap",
      [
        "expo-camera",
        {
          "cameraPermission": "SnapApp uses the camera to capture receipts and tax invoices.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EA542D",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#EA542D",
          "defaultChannel": "mail"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png"
  }
}
