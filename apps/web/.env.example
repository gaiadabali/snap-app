# Snap Apps web app — environment variables.
#
# No real secrets belong in this file or in any copy of it that is
# committed. Copy it to `.env.local` (git-ignored) and fill in real values
# there. `apps/web/src/lib/config.ts` refuses to start without the ones it
# actually needs and never supplies a fallback for a secret — a development
# default for a signing key is how a development signing key ends up in
# production.

# ── Where the Snap API lives ────────────────────────────────────────────────
# Server-to-server only: this app's Next.js server calls the Nest API and
# attaches the session cookie's token as an `Authorization: Bearer` header —
# the browser never talks to the API directly (docs/WEB.md §3.1). May be a
# private address in a real deployment.
SNAP_API_URL=http://127.0.0.1:4000

# This site's own public origin. Used to build the Google OAuth
# `redirect_uri` (which must exactly match what is registered with Google)
# and as `metadataBase` for absolute URLs in page metadata.
WEB_PUBLIC_URL=http://127.0.0.1:3000

# ── Google OAuth 2.0 + PKCE ──────────────────────────────────────────────────
# From a project in Google Cloud Console (APIs & Services → Credentials →
# OAuth client ID → Web application). Add
# `${WEB_PUBLIC_URL}/auth/google/callback` to that client's Authorized
# redirect URIs — for local dev, http://127.0.0.1:3000/auth/google/callback.
#
# Leaving these unset does not crash the app: `googleOauth()` is read lazily,
# only by the routes that actually start or complete a Google sign-in, and
# `/auth/google` catches the resulting error and redirects to sign-in with a
# plain "not configured yet" message instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Development sign-in bypass ───────────────────────────────────────────────
# Trades a bare email for a session with NO proof of ownership — a stand-in
# for the Google exchange until staging credentials exist (see
# docs/PLAN.md §7 and docs/WEB.md §7). Guarded by TWO independent conditions,
# both required:
#   1. This variable, set to exactly "true".
#   2. NODE_ENV is not "production" — set by the build/deploy, not here, and
#      not something this variable can override.
# Leave this unset (or anything other than "true") everywhere except a local
# or shared dev environment where signing in without Google is genuinely
# useful.
SNAP_DEV_AUTH_BYPASS=false

# ── Node environment ─────────────────────────────────────────────────────────
# Normally set by the hosting platform / build command, not here. Included
# for local clarity: `next dev` implies "development"; a production build and
# `next start` imply "production", which is what disables the dev bypass
# above regardless of SNAP_DEV_AUTH_BYPASS.
# NODE_ENV=development
